#!/usr/bin/env bash
# Purpose: Update all packages on the system

set -euo pipefail

shutdown=false
reboot=false
show_help=false
skip_dnf=false
skip_flatpak=false
for arg in "$@"; do
  case $arg in
    --shutdown)
      shutdown=true
      ;;
    --reboot)
      reboot=true
      ;;
    --skip-dnf)
      skip_dnf=true
      ;;
    --skip-flatpak)
      skip_flatpak=true
      ;;
    --help|-h)
      show_help=true
      ;;
  esac
done


if [ "$show_help" = true ]; then
  cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Options:
  --shutdown        Shutdown the system after updates
  --reboot          Reboot the system after updates
  --skip-dnf        Skip DNF package updates
  --skip-flatpak    Skip Flatpak updates
  --help, -h        Show this help message

This script updates all packages on the system, including:
  - DNF packages
  - auto-cpufreq
  - atuin
  - Flatpak packages
  - Antigravity IDE (via ag2-ide-update)

EOF
  exit 0
fi

(sudo -v; while true; do sleep 60; sudo -v; done) &
sudo_pid=$!

echo
if [ "$skip_dnf" = true ]; then
  printf "Skipping DNF packages...\n"
else
  printf "Updating DNF packages...\n"
  sudo dnf update --refresh -y
fi

echo
printf "Updating auto-cpufreq...\n"
sudo auto-cpufreq --update

echo
printf "Updating atuin...\n"
atuin-update

echo
if [ "$skip_flatpak" = true ]; then
  printf "Skipping Flatpaks...\n"
else
  printf "Updating Flatpaks...\n"
  flatpak update -y
fi

echo
printf "Updating Antigravity IDE...\n"
if command -v ag2-ide-update >/dev/null 2>&1; then
  ag2-ide-update
else
  printf "ag2-ide-update not found in PATH, skipping.\n"
fi

echo
printf "All updates completed successfully!\n"

if [ "$shutdown" = true ]; then
  echo "Shutting down the system..."
  sudo shutdown now
elif [ "$reboot" = true ]; then
  echo "Rebooting the system..."
  sudo reboot
fi

echo
printf "Ending sudo session...\n"
kill $sudo_pid
sudo -k
